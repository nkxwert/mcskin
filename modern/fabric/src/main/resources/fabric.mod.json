{
  "schemaVersion": 1,
  "id": "selfskin",
  "version": "${version}",
  "name": "Self Skin",
  "description": "A skin only you can see. Client-side only: nothing is sent to the server, so other players still see your real skin. Also hides your own armor, head block and cape (only for you).",
  "authors": ["nkxwert"],
  "contact": {
    "sources": "https://github.com/nkxwert/mcskin"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.selfskin.fabric.SelfSkinFabric"]
  },
  "mixins": ["selfskin.mixins.json"],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-key-mapping-api-v1": "*",
    "fabric-command-api-v2": "*",
    "fabric-lifecycle-events-v1": "*"
  }
}
